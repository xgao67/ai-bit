2.计算订单流不平衡


data = pd.read_csv('stock_data.csv')
print(data)
# 计算每一行收盘价与上一行收盘价的差值，得到价格变化，并将结果存储在名为 'Price Change' 的新列中
data['Price Change'] = data['Close'].diff()
# 根据价格变化判断是否为买入成交量
# 如果价格变化大于 0，说明价格上涨，将对应行的成交量赋值给 'Buy Volume' 列
# 如果价格变化不大于 0，将 0 赋值给 'Buy Volume' 列
data['Buy Volume'] = data['Volume'].where(data['Price Change'] > 0, 0)
# 根据价格变化判断是否为卖出成交量
# 如果价格变化小于 0，说明价格下跌，将对应行的成交量赋值给 'Sell Volume' 列
# 如果价格变化不小于 0，将 0 赋值给 'Sell Volume' 列
data['Sell Volume'] = data['Volume'].where(data['Price Change'] < 0, 0)
# 计算买入成交量的累积和，即从第一行到当前行的买入成交量总和
# 并将结果存储在名为 'Accumulated Buy Volume' 的新列中
data['Accumulated Buy Volume'] = data['Buy Volume'].cumsum()
# 计算卖出成交量的累积和，即从第一行到当前行的卖出成交量总和
# 并将结果存储在名为 'Accumulated Sell Volume' 的新列中
data['Accumulated Sell Volume'] = data['Sell Volume'].cumsum()
# 计算订单流的不平衡情况
# 用累积买入成交量减去累积卖出成交量，结果存储在名为 'Order Flow Imbalance' 的新列中
# 该值为正表示买入力量占优，为负表示卖出力量占优
data['Order Flow Imbalance'] = data['Accumulated Buy Volume'] - data['Accumulated Sell Volume']

3.确定支撑位和阻力位


def find_support_resistance(data, window=5, min_distance=0.5):
    """
    利用局部最小值和最大值来寻找支撑位和阻力位。
    :param data: 包含价格数据的 DataFrame。
    :param window: 用于查找局部最小值/最大值的周期数。
    :param min_distance: 不同水平之间的最小价格差异。
    :return: 支撑位和阻力位的列表。
    """
    # 查找局部最小值（支撑位）
    # 使用 rolling 方法，以 window 为窗口大小，在数据的 'Close' 列上进行滚动操作
    # center=True 表示将窗口的中心放在当前行，计算每个窗口内的最小值
    # 结果存储在 'Support' 列中
    data['Support'] = data['Close'].rolling(window=window, center=True).min()
    # 去除 'Support' 列中的重复值和缺失值，并将结果转换为列表
    support_levels = data['Support'].drop_duplicates().dropna().tolist()
    # 查找局部最大值（阻力位）
    # 同样使用 rolling 方法，计算每个窗口内的最大值
    # 结果存储在 'Resistance' 列中
    data['Resistance'] = data['Close'].rolling(window=window, center=True).max()
    # 去除 'Resistance' 列中的重复值和缺失值，并将结果转换为列表
    resistance_levels = data['Resistance'].drop_duplicates().dropna().tolist()
    # 根据最小距离过滤水平
    def filter_levels(levels, min_distance):
        """
        过滤掉距离小于最小距离的水平。
        :param levels: 支撑位或阻力位的列表。
        :param min_distance: 最小距离。
        :return: 过滤后的水平列表。
        """
        filtered_levels = []
        for level in levels:
            # 如果 filtered_levels 列表为空，或者当前水平与列表中最后一个水平的差值绝对值大于等于最小距离
            # 则将当前水平添加到 filtered_levels 列表中
            if not filtered_levels or abs(level - filtered_levels[-1]) >= min_distance:
                filtered_levels.append(level)
        return filtered_levels
    # 对支撑位列表进行过滤
    support_levels = filter_levels(support_levels, min_distance)
    # 对阻力位列表进行过滤
    resistance_levels = filter_levels(resistance_levels, min_distance)
    # 确保支撑位低于阻力位
    if support_levels and resistance_levels:
        # 找出支撑位列表中的最大值
        max_support = max(support_levels)
        # 找出阻力位列表中的最小值
        min_resistance = min(resistance_levels)
        # 移除高于最低阻力位的支撑位
        # 只保留小于最小阻力位的支撑位
        support_levels = [level for level in support_levels if level < min_resistance]
        # 移除低于最高支撑位的阻力位
        # 只保留大于最大支撑位的阻力位
        resistance_levels = [level for level in resistance_levels if level > max_support]
    return support_levels, resistance_levels

def enforce_min_vertical_spacing(levels, min_vertical_distance):
    """
    强制使各个水平之间具有最小垂直距离。
    :param levels: 支撑位或阻力位的列表。
    :param min_vertical_distance: 各个水平之间的最小垂直距离。
    :return: 经过过滤后的水平列表。
    """
    filtered_levels = []
    for level in sorted(levels):
        # 如果过滤后的列表为空，或者当前水平与过滤后列表中最后一个水平的差值
        # 大于等于最小垂直距离，则将当前水平添加到过滤后的列表中
        if not filtered_levels or (level - filtered_levels[-1]) >= min_vertical_distance:
            filtered_levels.append(level)
    return filtered_levels



# 定义最小垂直距离
min_vertical_distance = 10  # 例如，最小垂直距离为10
# 调用函数进行过滤
filtered_support_levels = enforce_min_vertical_spacing(support_levels, min_vertical_distance)
filtered_resistance_levels = enforce_min_vertical_spacing(resistance_levels, min_vertical_distance)
# 打印过滤后的水平
print("过滤后的支撑位:", filtered_support_levels)
print("过滤后的阻力位:", filtered_resistance_levels)


4.买卖信号生成


# 定义价格在支撑位/阻力位附近的价格范围
price_range_percentage = 0.002  # 0.2% 的价格范围
# 生成买入和卖出信号
# 在数据中新增 'Buy Signal' 列，并初始化为 False，表示目前没有买入信号
data['Buy Signal'] = False
# 在数据中新增 'Sell Signal' 列，并初始化为 False，表示目前没有卖出信号
data['Sell Signal'] = False
# 遍历数据的索引（从 1 开始，确保在计算差值时有前一个值）
for i in range(1, len(data)):  
    # 获取当前行的收盘价
    close_price = data['Close'].iloc[i]
    # 获取当前行的订单流不平衡值
    order_flow_imbalance = data['Order Flow Imbalance'].iloc[i]
    # 检查买入信号（价格接近支撑位且订单流不平衡值小于 0）
    for support_level in support_levels:
        # 如果收盘价在支撑位的一定百分比范围内
        if (close_price >= support_level * (1 - price_range_percentage)) and (close_price <= support_level * (1 + price_range_percentage)):
            # 并且订单流不平衡值小于 0
            if order_flow_imbalance < 0:
                # 将当前行的 'Buy Signal' 设置为 True，表示有买入信号
                data.at[data.index[i], 'Buy Signal'] = True
    # 检查卖出信号（价格接近阻力位且订单流不平衡值大于 0）
    for resistance_level in resistance_levels:
        # 如果收盘价在阻力位的一定百分比范围内
        if (close_price >= resistance_level * (1 - price_range_percentage)) and (close_price <= resistance_level * (1 + price_range_percentage)):
            # 并且订单流不平衡值大于 0
            if order_flow_imbalance > 0:
                # 将当前行的 'Sell Signal' 设置为 True，表示有卖出信号
                data.at[data.index[i], 'Sell Signal'] = True



