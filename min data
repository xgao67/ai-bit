
import akshare as ak
import pandas as pd
def get_stock_data(symbol, start_date, end_date, period='1', adjust=''):
    try:
        # 获取股票分钟级历史数据
        df = ak.stock_zh_a_hist_min_em(symbol=symbol, start_date=start_date, end_date=end_date, period=period,
                                       adjust=adjust)
        return df
    except Exception as e:
        print(f"获取数据时出现错误：{e}")
        return None
def process_stock_data(df):
    if df is None:
        return None
    # 重命名列名为英文
    df = df.rename(columns={
        '时间': 'Time',
        '开盘': 'Open',
        '收盘': 'Close',
        '最高': 'High',
        '最低': 'Low',
        '成交量': 'Volume',
        '成交额': 'Turnover',
        '均价': 'AveragePrice'
    })
    # 定义价格相关列和其他列
    price_columns = ['Open', 'Close', 'High', 'Low', 'AveragePrice']
    other_columns = ['Volume', 'Turnover']
    # 检查价格相关列的0值
    price_zero_count = 0
    for col in price_columns:
        zero_count = (df[col] == 0).sum()
        price_zero_count += zero_count
        if zero_count > 0:
            print(f"价格列 {col} 中存在 {zero_count} 个0值，进行前向填充处理")
            df[col] = df[col].replace(0, pd.NA).fillna(method='ffill')
    if price_zero_count > 0:
        print(f"价格相关列共存在 {price_zero_count} 个0值，已进行前向填充处理")
    # 检查其他列的0值（可根据实际情况决定是否处理）
    other_zero_count = 0
    for col in other_columns:
        zero_count = (df[col] == 0).sum()
        other_zero_count += zero_count
        if zero_count > 0:
            print(f"其他列 {col} 中存在 {zero_count} 个0值，需根据业务逻辑决定是否处理")
    if other_zero_count > 0:
        print(f"其他列共存在 {other_zero_count} 个0值，需根据业务逻辑决定是否处理")
    # 检查空值
    null_count = df.isnull().sum().sum()
    if null_count > 0:
        print(f"数据中存在 {null_count} 个空值，进行前向填充处理")
        df = df.fillna(method='ffill')
    return df
def save_data_to_csv(df, filename='stock_data.csv'):
    if df is not None:
        df.to_csv(filename, index=False)
        print(f"数据已保存到 {filename}")
def main():
    symbol = "300773"
    start_date = "2025-04-29 09:30:00"
